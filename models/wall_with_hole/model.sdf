<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="wall_with_hole">
    <!-- Define como estático (1/true) para a parede ficar fixa no chão e não cair com a gravidade -->
    <static>true</static>
    
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      
      <!-- ========================================================= -->
      <!-- GEOMETRIA DE COLISÃO (FÍSICA) -->
      <!-- Usar a malha STL garante que o buraco seja físico e o drone passe por ele -->
      <!-- ========================================================= -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://wall_with_hole/meshes/wall_with_hole.stl</uri>
            <!-- Se o modelo exportado do CAD estiver em milímetros e ficar gigante, altere para: 0.001 0.001 0.001 -->
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ========================================================= -->
      <!-- GEOMETRIA VISUAL (RENDERIZAÇÃO NO RVIZ / GAZEBO) -->
      <!-- ========================================================= -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://wall_with_hole/meshes/wall_with_hole.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        
        <!-- Cor cinza concreta padrão do Gazebo para a parede -->
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <!-- Se preferir definir uma cor RGBA manual, comente o <script> acima e use:
          <ambient>0.7 0.7 0.7 1.0</ambient>
          <diffuse>0.7 0.7 0.7 1.0</diffuse>
          -->
        </material>
      </visual>

    </link>
  </model>
</sdf>
